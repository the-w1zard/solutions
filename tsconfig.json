{
  "compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "es2023", "ES2021.WeakRef"],
		"target": "es2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": false,
		"allowJs": true,
		"strict": false,
		"isolatedModules": false,
		"skipLibCheck": true,
    "types":[
			"@the-w1zard/dx",
      "@the-w1zard/alias_types",
      "@the-w1zard/types",
      "node"
    ]
  },
  "include": [
    "**/*.ts"
 ],
  "exclude": ["node_modules", "dist", "rchive"],
  "paths": {
    "~/*": ["src/*"],
    "#STR": ["@the-w1zard/app_store"],
    "#HPR": ["@the-w1zard/prim_helpers"],
    "#PRIM": ["@the-w1zard/prims"],
  }
}
